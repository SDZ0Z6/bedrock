# Bedrock 成本监控平台 —— 本地配置
# 这个文件包含登录口令和会话密钥，不要提交到版本库或分享出去。

# ------------------------------------------------ 登录
AUTH_USERNAME=admin
AUTH_PASSWORD=请改成你自己的密码
# Flask 会话签名密钥。改动它会让已登录的会话全部失效。
SECRET_KEY=请用 python -c "import secrets;print(secrets.token_hex(32))" 生成
# 登录有效期（小时）
SESSION_HOURS=12

# ------------------------------------------------ 数据源
EXCEL_PATH=cred.xlsx

# ------------------------------------------------ Cost Explorer
# TAG/UNTAG 的拆分依据优先读 cred.xlsx 的 TAG 列（形如 map-migrated=migXYT8EVQSVP）。
# 下面这个 TAG_KEY 只在 TAG 列留空或整列缺失时兜底，此时「标签有任意非空值」算 TAG。
TAG_KEY=map-migrated
# UnblendedCost / AmortizedCost / NetUnblendedCost / NetAmortizedCost
COST_METRIC=UnblendedCost
# 留空 = 统计账号下全部服务。注意 Bedrock 上的 Claude 在 CE 里是按模型独立
# 计费条目（如 Claude Opus 5 (Amazon Bedrock Edition)），不叫 Amazon Bedrock。
SERVICE_FILTER=
# CE 每次请求约 0.01 USD，缓存秒数（0 = 关闭缓存）
CACHE_TTL=900

# 预估成本页的计价档：auto 自动判断跨区/本区（推荐），
# 判错时可强制填 global 或 standard
PRICE_TIER=auto

# ------------------------------------------------ 展示
CURRENCY_SYMBOL=$
# 使用率变黄 / 变红的阈值（百分比）
WARN_PCT=70
DANGER_PCT=90

# ------------------------------------------------ 运行
HOST=127.0.0.1
PORT=5000
DEBUG=false
