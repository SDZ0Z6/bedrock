# Bedrock 成本监控平台 —— 本地配置
# 这个文件包含登录口令和会话密钥，不要提交到版本库或分享出去。

# ------------------------------------------------ 登录
AUTH_USERNAME=admin
AUTH_PASSWORD=请改成你自己的密码
# Flask 会话签名密钥。改动它会让已登录的会话全部失效。
SECRET_KEY=请用 python -c "import secrets;print(secrets.token_hex(32))" 生成
# 登录有效期（小时）
SESSION_HOURS=12

# ------------------------------------------------ 数据源
EXCEL_PATH=cred.xlsx

# ------------------------------------------------ Cost Explorer
# TAG/UNTAG 的拆分依据优先读 cred.xlsx 的 TAG 列（形如 map-migrated=migXYT8EVQSVP）。
# 下面这个 TAG_KEY 只在 TAG 列留空或整列缺失时兜底，此时「标签有任意非空值」算 TAG。
TAG_KEY=map-migrated
# UnblendedCost / AmortizedCost / NetUnblendedCost / NetAmortizedCost
COST_METRIC=UnblendedCost
# 留空 = 统计账号下全部服务。注意 Bedrock 上的 Claude 在 CE 里是按模型独立
# 计费条目（如 Claude Opus 5 (Amazon Bedrock Edition)），不叫 Amazon Bedrock。
SERVICE_FILTER=
# CE 每次请求约 0.01 USD，缓存秒数（0 = 关闭缓存）
CACHE_TTL=900

# 预估成本页的计价档：auto 自动判断跨区/本区（推荐），
# 判错时可强制填 global 或 standard
PRICE_TIER=auto

# ------------------------------------------------ 展示
CURRENCY_SYMBOL=$
# 使用率变黄 / 变红的阈值（百分比）
WARN_PCT=70
DANGER_PCT=90

# ------------------------------------------------ 运行
HOST=127.0.0.1
PORT=5000
DEBUG=false

# ------------------------------------------------ Telegram 告警
# 开关和群组 ID 是每个账号的，在账号管理页里改（存在台账的 TG_ENABLED / TG_CHAT_IDS
# 两列，一个账号可以填几个群）。这里只放全局的几项。
#
# Bot Token：在 Telegram 里找 @BotFather，/newbot 建一个 bot 拿到。只放这里——页面上
# 看不到也改不了，能登录的人就能看到页面，Token 泄露等于别人能冒充这个 bot 发消息。
# 留空 = 不发任何 TG 消息（开关照样能存，只是不生效）。
TELEGRAM_BOT_TOKEN=
# 额度使用率达到这些百分比时各发一次告警
TELEGRAM_THRESHOLDS=50,80,90,100
# 连续多少个整点小时零调用算「用量中断」。MAP 流量常有突发空档，嫌吵就调大
TELEGRAM_IDLE_HOURS=1
# 每张告警卡片底部的署名。写成空（TELEGRAM_CARD_SIGNATURE=）就不画这一行
TELEGRAM_CARD_SIGNATURE=This message was sent automatically by pokemoncloud
# 告警状态文件（上次有没有用量、哪些额度档位发过）。相对路径相对项目根
# ALERT_STATE_PATH=alert-state.json
# 每个账号上一次查询成功的累计消费，CE 查不到时概览页和日报拿它顶上。相对路径相对项目根
# LAST_KNOWN_COSTS_PATH=last-known-costs.json

# ------------------------------------------------ 邮件告警
# 邮箱（平台、地址、密码）和开关是每个账号的，在账号管理页里填（存在台账的 MAIL_* 几列）。
# 发 TG 用的还是上面的 TELEGRAM_BOT_TOKEN。这里只放全局的几项。
#
# 固定群：root 账号安全类的邮件（MFA 被停用、登录要验证、重置密码）先发这里；邮件里写的
# 账号不在台账里、或那个账号没开 TG 告警时也发这里。逗号隔开。留空 = 只发账号自己的群
MAIL_ALERT_CHAT_IDS=
# 同一个账号、同一个主题的告警多少分钟内只发一次（AWS 常把同一条通知发两遍）
MAIL_DEDUPE_MINUTES=60
# 连邮箱服务器的超时（秒）
MAIL_TIMEOUT=20
# 收信进度和去重记录。相对路径相对项目根
# MAIL_STATE_PATH=mail-state.json
